{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hookrelay",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",

	// Public URL: https://hookrelay.<account-subdomain>.workers.dev
	"workers_dev": true,
	"preview_urls": true,

	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},

	// Non-secret configuration. Secrets (webhook signing keys) are set with
	// `wrangler secret put` and never committed. See .dev.vars.example.
	"vars": {
		"APP_NAME": "hookrelay",
		"GIT_SHA": "local",
		"MAX_BODY_BYTES": "262144"
	}

	// Phase 1 adds the D1 database (events, deliveries) and the Queue
	// (delivery pipeline + dead-letter queue). See docs/roadmap.md.
}
